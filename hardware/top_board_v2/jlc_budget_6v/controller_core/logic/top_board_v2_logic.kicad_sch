    (effects
      (font
        (size 0.889 0.889)
      )
      (justify left)
    )
    (uuid 85a5e8d2-fbef-5491-a4bc-341fb40fea93)
  )
  (text "Two supply converters; default ARM pull-down fitted once."
    (at 208.28 78.74 0)
    (effects
      (font
        (size 0.889 0.889)
      )
      (justify left)
    )
    (uuid 75810be3-c99a-5d47-b05b-f291105d669d)
  )
  (text "Voltage dividers included; ADC readout implemented, hardware unqualified."
    (at 208.28 91.44 0)
    (effects
      (font
        (size 0.889 0.889)
      )
      (justify left)
    )
    (uuid b6d3815a-5973-5285-bb30-8ff51e7cb67a)
  )
  (text "Existing bottom drivers are reused. No onboard charging circuit."
