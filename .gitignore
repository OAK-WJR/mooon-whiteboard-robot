# ---------------------------------------------------------------------------
# Local environments, toolchains and build output
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
node_modules/

# PlatformIO (core_dir = .platformio keeps the toolchain inside the repo folder)
.pio/
.pioenvs/
.piolibdeps/
.piobuild/
.platformio/
platformio.ini.bak

# clangd
compile_commands.json
.cache/

# Compiled artifacts
*.bin
*.elf
*.o

# ---------------------------------------------------------------------------
# Local configuration and secrets (never commit)
# ---------------------------------------------------------------------------
.env
.env.local
*.local
include/config.h
.ota_token
.robot_host
*.pem
*.key

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Raw experiment data and scratch space (kept locally, not published)
# ---------------------------------------------------------------------------
*.log
*.jsonl
*.dat
*.raw
/tmp/
/pcb-analysis/
c6_drive/reports/
c6_drive/portfolio/*.zip

# ---------------------------------------------------------------------------
# Third-party reference material: datasheets, saved vendor web pages and
# 3D models. These belong to their publishers and are not redistributed here.
# ---------------------------------------------------------------------------
**/sources/
*.step
*.stp
*.STEP
*.wrl
*.zip

# Simulation renders (the summary video whiteboardbot-control-study.mp4 is kept)
c6_drive/portfolio/mujoco-*.mp4
c6_drive/portfolio/robust/*.mp4

# KiCad local history
.history/

# ---------------------------------------------------------------------------
# Curated snapshot: raw logs, videos and EasyEDA backups stay offline
# ---------------------------------------------------------------------------
c6_wall/logs/
c6_wall/tools/vision_cache.json
*.mp4
!docs/media/coverage-run.mp4
hardware/top_board_v2/versions/*.epro2
**/*.kicad_prl
**/*.lck
**/*-backups/

# Key run logs that the README cites
!c6_wall/results/*.log
